{
  "name": "buck-workflow",
  "version": "0.2.0",
  "description": "Buck workflow for structured AI-assisted development — plan, build, review, save with durable context management",
  "bin": {
    "buck-workflow": "./scripts/install.ts"
  },
  "type": "module",
  "files": [
    "skills",
    "plugins/buck-workflow/skills/b-build-hard",
    "plugins/buck-workflow/skills/b-commit",
    "prompts",
    "commands",
    "extensions",
    "hooks",
    "migrations",
    "scripts",
    "docs",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "agent-install_instructions.md",
    "GLOBAL_OR_PROJECT-AGENTS.md"
  ],
  "keywords": [
    "pi-package",
    "ai-agent",
    "workflow",
    "skills",
    "agent-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evilbuck/buck-workflow-pi.git"
  },
  "homepage": "https://github.com/evilbuck/buck-workflow-pi#readme",
  "bugs": {
    "url": "https://github.com/evilbuck/buck-workflow-pi/issues"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "commands": [
      "./commands"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "xstate": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@oh-my-pi/pi-coding-agent": "18.1.17",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun run test:vitest && bun run test:bun && bun run test:sqlite-runtime",
    "test:vitest": "bun --bun vitest run",
    "test:bun": "bun test skills/b-memory-import/scripts/import-context-memory.test.ts skills/b-auto-fix/scripts/auto-fix.test.ts skills/pack-self-contained-html-reports/scripts/pack.test.ts",
    "test:sqlite-runtime": "bun skills/_shared/storage/sqlite-runtime-smoke.ts",
    "test:ui": "bun --bun vitest --ui",
    "test:e2e": "bunx --bun playwright test",
    "test:e2e:ui": "bunx --bun playwright test --ui",
    "test:e2e:debug": "bunx --bun playwright test --debug",
    "test:e2e:chromium": "bunx --bun playwright test --project=chromium",
    "playwright": "bunx --bun playwright",
    "playwright:install": "bunx --bun playwright install chromium",
    "playwright:report": "bunx --bun playwright show-report",
    "context:index": "bun scripts/context-artifacts.ts index",
    "context:validate": "bun scripts/context-artifacts.ts validate",
    "presentations:serve": "bun scripts/serve-presentations.ts",
    "site:serve": "bun scripts/serve-presentations.ts --dir site",
    "prepublishOnly": "bun run test",
    "release": "bun scripts/publish.ts",
    "guardrails:check": "bun skills/b-guardrails-check/scripts/check.ts",
    "subject-lifecycle:check": "bun skills/_shared/scripts/subject-lifecycle.ts audit --repo . --json"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@oh-my-pi/pi-coding-agent": "^19.2.1",
    "@oh-my-pi/pi-tui": "^19.2.1",
    "@playwright/test": "^1.60.0",
    "@sinclair/typebox": "^0.34.52",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true,
    "koffi@2.16.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
